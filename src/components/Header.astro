---
import { site } from '../config';
const path = Astro.url.pathname;
const links = [
  { href: '/#about', label: 'About' },
  { href: '/flik/', label: 'FLIK', match: '/flik' },
  { href: '/kitabisa/', label: 'Kitabisa', match: '/kitabisa' },
  { href: '/yourspace/', label: 'YourSpace', match: '/yourspace' },
  { href: '/bejopos/', label: 'Bejo POS', match: '/bejopos' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site">
  <div class="bar">
    <a class="brand" href="/">{site.name}</a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={l.match && path.startsWith(l.match) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle light or dark theme">Theme</button>
  </div>
</header>
