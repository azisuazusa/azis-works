---
interface Props {
  data: { month: string; prs: number }[];
  caption: string;
}
const { data, caption } = Astro.props;
const W = 720, H = 190, padL = 28, padB = 24, padT = 8;
const max = Math.max(...data.map((d) => d.prs));
const top = Math.ceil(max / 10) * 10;
const bw = (W - padL) / data.length;
const y = (v: number) => padT + (H - padT - padB) * (1 - v / top);
const years = [...new Set(data.map((d) => d.month.slice(0, 4)))];
const alt = `Merged pull requests per month, ${data[0].month} to ${data[data.length - 1].month}, peaking at ${max} in one month.`;
---

<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={alt}>
    {[0, top / 2, top].map((t) => (
      <g>
        <line x1={padL} x2={W} y1={y(t)} y2={y(t)} stroke="var(--line)" stroke-width="1" />
        <text x={padL - 6} y={y(t) + 4} text-anchor="end" font-size="10" fill="var(--muted)">{t}</text>
      </g>
    ))}
    {data.map((d, i) => (
      <rect
        x={padL + i * bw + 1}
        y={y(d.prs)}
        width={Math.max(bw - 2, 1)}
        height={H - padB - y(d.prs)}
        rx="1.5"
        fill="var(--bar)"
      >
        <title>{d.month}: {d.prs} merged PRs</title>
      </rect>
    ))}
    {years.map((yr) => {
      const idx = data.findIndex((d) => d.month.startsWith(yr));
      return <text x={padL + idx * bw} y={H - 6} font-size="10" fill="var(--muted)">{yr}</text>;
    })}
  </svg>
  <figcaption>{caption}</figcaption>
</figure>
